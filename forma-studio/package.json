{
  "name": "forma-studio",
  "productName": "Forma Studio",
  "version": "0.2.0",
  "description": "A friendly, offline 3D scene and motion studio for Windows.",
  "main": "desktop/main.cjs",
  "author": "Emmanuel Suah",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "package:win": "npm run build && node scripts/package-windows.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.0",
    "three": "0.180.0"
  }
}

#include <windows.h>

101 ICON "typebloom.ico"
1 24 "typebloom.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Emmanuel Suah\0"
      VALUE "FileDescription", "TypeBloom desktop typing speed widget\0"
      VALUE "FileVersion", "1.0.0.0\0"
      VALUE "InternalName", "TypeBloom\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Emmanuel Suah\0"
      VALUE "OriginalFilename", "TypeBloom.exe\0"
      VALUE "ProductName", "TypeBloom\0"
      VALUE "ProductVersion", "1.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
